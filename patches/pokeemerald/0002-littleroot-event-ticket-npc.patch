diff --git a/data/maps/LittlerootTown/scripts.inc b/data/maps/LittlerootTown/scripts.inc
--- a/data/maps/LittlerootTown/scripts.inc
+++ b/data/maps/LittlerootTown/scripts.inc
@@ -241,9 +241,111 @@
 	msgbox LittlerootTown_Text_CanUsePCToStoreItems, MSGBOX_NPC
 	end
 
-LittlerootTown_EventScript_Boy::
-	msgbox LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
-	end
+LittlerootTown_EventScript_Boy::
+	msgbox LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
+	end
+@ Permanent offline replacement for historical external ticket distribution.
+@ The NPC stays independent from story state and can be revisited at any time.
+LittlerootTown_EventScript_EventTicketCourier::
+	lock
+	faceplayer
+	setvar VAR_TEMP_0, 0
+	setvar VAR_TEMP_1, 0
+	msgbox LittlerootTown_Text_EventTicketCourierIntro, MSGBOX_DEFAULT
+	call LittlerootTown_EventScript_GiveEonTicket
+	call LittlerootTown_EventScript_GiveMysticTicket
+	call LittlerootTown_EventScript_GiveAuroraTicket
+	call LittlerootTown_EventScript_GiveOldSeaMap
+	goto_if_eq VAR_TEMP_1, 1, LittlerootTown_EventScript_EventTicketCourierBagFull
+	goto_if_eq VAR_TEMP_0, 0, LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered
+	msgbox LittlerootTown_Text_EventTicketCourierDelivered, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierBagFull::
+	msgbox LittlerootTown_Text_EventTicketCourierBagFull, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered::
+	msgbox LittlerootTown_Text_EventTicketCourierAlreadyDelivered, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_GiveEonTicket::
+	checkitem ITEM_EON_TICKET
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_GiveEonTicket_Return
+	checkitemspace ITEM_EON_TICKET
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_GiveEonTicket_NoRoom
+	giveitem ITEM_EON_TICKET
+	setflag FLAG_ENABLE_SHIP_SOUTHERN_ISLAND
+	setvar VAR_TEMP_0, 1
+LittlerootTown_EventScript_GiveEonTicket_Return::
+	return
+LittlerootTown_EventScript_GiveEonTicket_NoRoom::
+	setvar VAR_TEMP_1, 1
+	return
+
+LittlerootTown_EventScript_GiveMysticTicket::
+	checkitem ITEM_MYSTIC_TICKET
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_GiveMysticTicket_Return
+	checkitemspace ITEM_MYSTIC_TICKET
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_GiveMysticTicket_NoRoom
+	giveitem ITEM_MYSTIC_TICKET
+	setflag FLAG_ENABLE_SHIP_NAVEL_ROCK
+	setflag FLAG_RECEIVED_MYSTIC_TICKET
+	setvar VAR_TEMP_0, 1
+LittlerootTown_EventScript_GiveMysticTicket_Return::
+	return
+LittlerootTown_EventScript_GiveMysticTicket_NoRoom::
+	setvar VAR_TEMP_1, 1
+	return
+
+LittlerootTown_EventScript_GiveAuroraTicket::
+	checkitem ITEM_AURORA_TICKET
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_GiveAuroraTicket_Return
+	checkitemspace ITEM_AURORA_TICKET
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_GiveAuroraTicket_NoRoom
+	giveitem ITEM_AURORA_TICKET
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	setflag FLAG_RECEIVED_AURORA_TICKET
+	setvar VAR_TEMP_0, 1
+LittlerootTown_EventScript_GiveAuroraTicket_Return::
+	return
+LittlerootTown_EventScript_GiveAuroraTicket_NoRoom::
+	setvar VAR_TEMP_1, 1
+	return
+
+LittlerootTown_EventScript_GiveOldSeaMap::
+	checkitem ITEM_OLD_SEA_MAP
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_GiveOldSeaMap_Return
+	checkitemspace ITEM_OLD_SEA_MAP
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_GiveOldSeaMap_NoRoom
+	giveitem ITEM_OLD_SEA_MAP
+	setflag FLAG_ENABLE_SHIP_FARAWAY_ISLAND
+	setflag FLAG_RECEIVED_OLD_SEA_MAP
+	setvar VAR_TEMP_0, 1
+LittlerootTown_EventScript_GiveOldSeaMap_Return::
+	return
+LittlerootTown_EventScript_GiveOldSeaMap_NoRoom::
+	setvar VAR_TEMP_1, 1
+	return
+
+LittlerootTown_Text_EventTicketCourierIntro:
+	.string "I have some special items that were\\n"
+	.string "entrusted to me for you.$"
+
+LittlerootTown_Text_EventTicketCourierDelivered:
+	.string "That's everything I can deliver now.\\n"
+	.string "Please keep them safe.$"
+
+LittlerootTown_Text_EventTicketCourierBagFull:
+	.string "It looks like I couldn't hand over\\n"
+	.string "everything. Make some room and return.$"
+
+LittlerootTown_Text_EventTicketCourierAlreadyDelivered:
+	.string "Everything entrusted to me has already\\n"
+	.string "been delivered.$"
 
 LittlerootTown_EventScript_Twin::
 	lock
