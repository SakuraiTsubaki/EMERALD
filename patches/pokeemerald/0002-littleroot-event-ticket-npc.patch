diff --git a/data/maps/LittlerootTown/scripts.inc b/data/maps/LittlerootTown/scripts.inc
--- a/data/maps/LittlerootTown/scripts.inc
+++ b/data/maps/LittlerootTown/scripts.inc
@@ -241,9 +241,114 @@
 	msgbox LittlerootTown_Text_CanUsePCToStoreItems, MSGBOX_NPC
 	end
 
-LittlerootTown_EventScript_Boy::
-	msgbox LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
-	end
+LittlerootTown_EventScript_Boy::
+	msgbox LittlerootTown_Text_BirchSpendsDaysInLab, MSGBOX_NPC
+	end
+
+@ Permanent offline replacement for historical external ticket distribution.
+@ Choose exactly one ticket per interaction; revisit the NPC for another.
+LittlerootTown_EventScript_EventTicketCourier::
+	lock
+	faceplayer
+	msgbox LittlerootTown_Text_EventTicketCourierIntro, MSGBOX_DEFAULT
+	multichoice 0, 0, MULTI_EVENT_TICKETS, FALSE
+	switch VAR_RESULT
+	case 0, LittlerootTown_EventScript_SelectEonTicket
+	case 1, LittlerootTown_EventScript_SelectMysticTicket
+	case 2, LittlerootTown_EventScript_SelectAuroraTicket
+	case 3, LittlerootTown_EventScript_SelectOldSeaMap
+	case MULTI_B_PRESSED, LittlerootTown_EventScript_EventTicketCourierCancel
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierCancel::
+	release
+	end
+
+LittlerootTown_EventScript_SelectEonTicket::
+	checkitem ITEM_EON_TICKET
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_EonTicketAlreadyDelivered
+	checkitemspace ITEM_EON_TICKET
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_EventTicketCourierBagFull
+	giveitem ITEM_EON_TICKET
+	setflag FLAG_ENABLE_SHIP_SOUTHERN_ISLAND
+	goto LittlerootTown_EventScript_EventTicketCourierDelivered
+
+LittlerootTown_EventScript_EonTicketAlreadyDelivered::
+	setflag FLAG_ENABLE_SHIP_SOUTHERN_ISLAND
+	goto LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered
+
+LittlerootTown_EventScript_SelectMysticTicket::
+	checkitem ITEM_MYSTIC_TICKET
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_MysticTicketAlreadyDelivered
+	checkitemspace ITEM_MYSTIC_TICKET
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_EventTicketCourierBagFull
+	giveitem ITEM_MYSTIC_TICKET
+	setflag FLAG_ENABLE_SHIP_NAVEL_ROCK
+	setflag FLAG_RECEIVED_MYSTIC_TICKET
+	goto LittlerootTown_EventScript_EventTicketCourierDelivered
+
+LittlerootTown_EventScript_MysticTicketAlreadyDelivered::
+	setflag FLAG_ENABLE_SHIP_NAVEL_ROCK
+	setflag FLAG_RECEIVED_MYSTIC_TICKET
+	goto LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered
+
+LittlerootTown_EventScript_SelectAuroraTicket::
+	checkitem ITEM_AURORA_TICKET
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_AuroraTicketAlreadyDelivered
+	checkitemspace ITEM_AURORA_TICKET
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_EventTicketCourierBagFull
+	giveitem ITEM_AURORA_TICKET
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	setflag FLAG_RECEIVED_AURORA_TICKET
+	goto LittlerootTown_EventScript_EventTicketCourierDelivered
+
+LittlerootTown_EventScript_AuroraTicketAlreadyDelivered::
+	setflag FLAG_ENABLE_SHIP_BIRTH_ISLAND
+	setflag FLAG_RECEIVED_AURORA_TICKET
+	goto LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered
+
+LittlerootTown_EventScript_SelectOldSeaMap::
+	checkitem ITEM_OLD_SEA_MAP
+	goto_if_eq VAR_RESULT, TRUE, LittlerootTown_EventScript_OldSeaMapAlreadyDelivered
+	checkitemspace ITEM_OLD_SEA_MAP
+	goto_if_eq VAR_RESULT, FALSE, LittlerootTown_EventScript_EventTicketCourierBagFull
+	giveitem ITEM_OLD_SEA_MAP
+	setflag FLAG_ENABLE_SHIP_FARAWAY_ISLAND
+	setflag FLAG_RECEIVED_OLD_SEA_MAP
+	goto LittlerootTown_EventScript_EventTicketCourierDelivered
+
+LittlerootTown_EventScript_OldSeaMapAlreadyDelivered::
+	setflag FLAG_ENABLE_SHIP_FARAWAY_ISLAND
+	setflag FLAG_RECEIVED_OLD_SEA_MAP
+	goto LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered
+
+LittlerootTown_EventScript_EventTicketCourierDelivered::
+	msgbox LittlerootTown_Text_EventTicketCourierDelivered, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierBagFull::
+	msgbox LittlerootTown_Text_EventTicketCourierBagFull, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_EventScript_EventTicketCourierAlreadyDelivered::
+	msgbox LittlerootTown_Text_EventTicketCourierAlreadyDelivered, MSGBOX_DEFAULT
+	release
+	end
+
+LittlerootTown_Text_EventTicketCourierIntro:
+	.string "Which item should I deliver to you?$"
+
+LittlerootTown_Text_EventTicketCourierDelivered:
+	.string "Delivery complete. Please keep it safe.$"
+
+LittlerootTown_Text_EventTicketCourierBagFull:
+	.string "There isn't enough room in your BAG.$"
+
+LittlerootTown_Text_EventTicketCourierAlreadyDelivered:
+	.string "I've already delivered that item to you.$"
 
 LittlerootTown_EventScript_Twin::
 	lock

