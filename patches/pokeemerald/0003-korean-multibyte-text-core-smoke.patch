+        0xFF,0x6F,0xFF,0x6F,0xFF,0x6F,0x56,0x55,0xAA,0xAA,0xFF,0xFF,0x00,0x00,0x00,0x00,
+        0x00,0xDA,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xEB,0x00,0x00,0x00,0x00,
+    },
+    { // 다 U+B2E4
+        0x00,0x00,0x00,0x00,0x56,0x55,0xAA,0x6A,0xFF,0x6F,0xFF,0x6F,0xFF,0x6F,0xFF,0x6F,
+        0x00,0x00,0x00,0x00,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xD6,
+        0xFF,0x6F,0xFF,0x6F,0xFF,0x6F,0x56,0x55,0xAA,0xAA,0xFF,0xFF,0x00,0x00,0x00,0x00,
+        0x00,0xDA,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xEB,0x00,0x00,0x00,0x00,
+    },
+    { // 라 U+B77C
+        0x00,0x00,0x00,0x00,0x5B,0x55,0x9B,0xAA,0xDB,0xFF,0xDB,0xFF,0x5B,0x55,0xAB,0x6A,
+        0x00,0x00,0x00,0x00,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xD6,
+        0xFF,0x6F,0xFF,0x6F,0xFF,0x6F,0x56,0x55,0xAA,0xAA,0xFF,0xFF,0x00,0x00,0x00,0x00,
+        0x00,0xDA,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xDB,0x00,0xEB,0x00,0x00,0x00,0x00,
+    },
+};
+
+static s8 GetSmokeIndex(u16 codepoint)
+{
+    switch (codepoint)
+    {
+    case 0xAC00: return 0;
+    case 0xB098: return 1;
+    case 0xB2E4: return 2;
+    case 0xB77C: return 3;
+    default: return -1;
+    }
+}
+
+bool8 KoreanText_IsSupportedCodepoint(u16 codepoint)
+{
+    return (codepoint >= 0xAC00 && codepoint <= 0xD7A3)
+        || (codepoint >= 0x3131 && codepoint <= 0x3163);
+}
+
+bool8 KoreanText_HasSmokeGlyph(u16 codepoint, u8 fontId)
+{
+    return fontId == FONT_NORMAL && GetSmokeIndex(codepoint) >= 0;
+}
+
+u8 KoreanText_GetGlyphWidth(u16 codepoint, u8 fontId)
+{
+    if (!KoreanText_HasSmokeGlyph(codepoint, fontId))
+        return 0;
+    return 12;
+}
+
+bool8 KoreanText_DecompressGlyph(u16 codepoint, u8 fontId)
+{
+    s8 index = GetSmokeIndex(codepoint);
+    const u8 *glyph;
+
+    if (fontId != FONT_NORMAL || index < 0)
+        return FALSE;
+
+    glyph = sKoreanSmokeNormalGlyphs[index];
+    DecompressGlyphTile(glyph + 0x00, gCurGlyph.gfxBufferTop);
+    DecompressGlyphTile(glyph + 0x10, gCurGlyph.gfxBufferTop + 8);
+    DecompressGlyphTile(glyph + 0x20, gCurGlyph.gfxBufferBottom);
+    DecompressGlyphTile(glyph + 0x30, gCurGlyph.gfxBufferBottom + 8);
+    gCurGlyph.width = 12;
+    gCurGlyph.height = 16;
+    return TRUE;
+}
