From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 1/1] Make core external events permanently accessible

Reference: pret/pokeemerald @ 5eff78649e7170a877b961ef0b3da13b81a16038

This patch removes external-distribution gates from the four S.S. Tidal
event-island destinations and makes every Altering Cave encounter table
available without Mystery Gift.

It intentionally does not set caught/defeated/completion flags.

diff --git a/src/script_menu.c b/src/script_menu.c
--- a/src/script_menu.c
+++ b/src/script_menu.c
@@
-    if (CheckBagHasItem(ITEM_EON_TICKET, 1) == TRUE && FlagGet(FLAG_ENABLE_SHIP_SOUTHERN_ISLAND) == TRUE)
+    if (TRUE)
@@
-    if (CheckBagHasItem(ITEM_MYSTIC_TICKET, 1) == TRUE && FlagGet(FLAG_ENABLE_SHIP_NAVEL_ROCK) == TRUE)
+    if (TRUE)
@@
-    if (CheckBagHasItem(ITEM_AURORA_TICKET, 1) == TRUE && FlagGet(FLAG_ENABLE_SHIP_BIRTH_ISLAND) == TRUE)
+    if (TRUE)
@@
-    if (CheckBagHasItem(ITEM_OLD_SEA_MAP, 1) == TRUE && FlagGet(FLAG_ENABLE_SHIP_FARAWAY_ISLAND) == TRUE)
+    if (TRUE)

diff --git a/src/wild_encounter.c b/src/wild_encounter.c
--- a/src/wild_encounter.c
+++ b/src/wild_encounter.c
@@
-                u16 alteringCaveId = VarGet(VAR_ALTERING_CAVE_WILD_SET);
-                if (alteringCaveId >= NUM_ALTERING_CAVE_TABLES)
-                    alteringCaveId = 0;
+                // External Mystery Gift originally selected one table through
+                // VAR_ALTERING_CAVE_WILD_SET. Keep every table permanently
+                // reachable without any external distribution.
+                u16 alteringCaveId = Random() % NUM_ALTERING_CAVE_TABLES;
 
                 i += alteringCaveId;
             }
