From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Lock EMERALD expanded profile regional-form support on

Reference: rh-hideout/pokeemerald-expansion @ 75b806a3ab57a81ff1eb6179288981f0b3cc3050

The upstream defaults already enable these systems. These compile-time guards make
that dependency explicit for the EMERALD expanded profile so an accidental config
change cannot silently drop regional forms or required cross-generation branches.

diff --git a/include/config/species_enabled.h b/include/config/species_enabled.h
--- a/include/config/species_enabled.h
+++ b/include/config/species_enabled.h
@@ -34,6 +34,15 @@
 #define P_HISUIAN_FORMS                  P_REGIONAL_FORMS
 #define P_PALDEAN_FORMS                  P_REGIONAL_FORMS
 
+#if !P_REGIONAL_FORMS
+#error "EMERALD expanded profile requires P_REGIONAL_FORMS"
+#endif
+
+#if !P_CROSS_GENERATION_EVOS
+#error "EMERALD expanded profile requires P_CROSS_GENERATION_EVOS"
+#endif
+
 // Big groups of forms that aren't always desired when choosing families.
 #define P_PIKACHU_EXTRA_FORMS            TRUE
 #define P_COSPLAY_PIKACHU_FORMS          P_PIKACHU_EXTRA_FORMS
